<?xml version="1.0" encoding="utf-8" ?>
<!-- Declaração XML padrão com codificação UTF-8 -->

<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OlaMaui.MainPage">
    <!-- Página principal da aplicação MAUI.
         xmlns = namespace padrão dos controles MAUI
         xmlns:x = namespace para recursos XAML
         x:Class = classe C# associada a esta página -->

    <ScrollView>
        <Grid>
            
            
            
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="210" />
                <RowDefinition Height="100" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <StackLayout Grid.Row="0" HorizontalOptions="Center" >
                <Image Source="dotnet_bot.png" WidthRequest="150" HeightRequest="150" />
                <Label Text="Faça seu cadastro" FontAttributes="Bold" FontSize="24" HorizontalOptions="Center" />

            </StackLayout>

            <StackLayout Grid.Row="1"  HorizontalOptions="Center" >
                <StackLayout WidthRequest="320">
                    <Label Text="Nome completo"/>
                    <Entry x:Name="NomeCompleto" Keyboard="Text"  Placeholder="EX José Fernando"/>
                </StackLayout>

                <StackLayout WidthRequest="320" Margin="0,10,0,0">
                    <Label Text="Data de Nascimento"/>
                    <DatePicker x:Name="DataNascimento" Format="dd/MM/yyyy"/>
                </StackLayout>

                <StackLayout WidthRequest="320" Margin="0,10,0,0">
                    <Label Text="Gênero"/>
                    <Picker x:Name="Genero">
                        <Picker.Items>
                            <x:String>Feminino</x:String>
                            <x:String>Masculino</x:String>
                            <x:String>Prefiro não declarar</x:String>
                        </Picker.Items>                        
                    </Picker>
                </StackLayout>

                <StackLayout WidthRequest="320" Margin="0,10,0,0">
                    <Label Text="Idade"/>
                    <Entry x:Name="Idade" Keyboard="Numeric" Placeholder="XX"/>
                </StackLayout>
                
                
                
            </StackLayout>


            <StackLayout Grid.Row="2" WidthRequest="320" Margin="0,10,0,0">
                <Button Text="Cadastra" x:Name="BtnCadastro" Clicked="AlterarStatus" />  
            </StackLayout>

            <StackLayout Grid.Row="3" HorizontalOptions="Center" >
                <Label x:Name="Status" Text="Preencha os campos para concluir o cadastro"/>
            </StackLayout>

			<StackLayout></StackLayout>            
            
        </Grid>

    </ScrollView>

</ContentPage>
