<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NavegacaoEntreTelas.Cadastro">


    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="Tela de cadastro" FontSize="32" FontAttributes="Bold" Margin="0,40" HorizontalTextAlignment="Center" />
        <Grid RowDefinitions="*,*,*,*,*,*,*"  WidthRequest="400" VerticalOptions="Center" >
            <Label Grid.Row="0" Text="Nome completo" FontAttributes="Bold" />
            <Entry Grid.Row="1" Placeholder="Fulano da silva" Margin="0,0,0,40" />
            <Label Grid.Row="2" Text="E-mail" />
            <Entry Grid.Row="3" Placeholder="exemplo@exemplo.com.br" Margin="0,0,0,40" />
            <Label Grid.Row="4" Text="Senha" />
            <Entry Grid.Row="5" Placeholder="******"  Margin="0,0,0,40"/>
            <Button Grid.Row="6" Text="Cadastrar" Clicked="OnCadastrarClicked"/>




        </Grid>
    </VerticalStackLayout>



</ContentPage>